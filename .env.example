# Copie para .env.local e preencha. NUNCA comite o .env.local.
#
# As duas primeiras vão para o navegador (prefixo NEXT_PUBLIC_) e podem
# aparecer no HTML — é assim que o Supabase funciona, e a RLS é o que protege
# o banco. A terceira é SEGREDO: ela ignora a RLS por completo.
#
# Onde achar: painel do Supabase → Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SEGREDO — só servidor. Nunca prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# A URL onde o site roda. Em produção, o domínio da Vercel.
# Ela monta o callback do Google, o link público da barbearia e os links que
# vão dentro das mensagens de WhatsApp.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Google Geocoding API — transforma o endereço da barbearia em latitude e
# longitude, que é o que a faz aparecer no filtro "Próximas" do app.
#
# SEM NEXT_PUBLIC_, e é de propósito: só o servidor lê. Chave de geocoding no
# navegador é chave pública, e chave pública com billing ligado é conta que
# outra pessoa gasta.
#
# Onde tirar: console.cloud.google.com → APIs e serviços → Credenciais. Habilite
# a "Geocoding API" no projeto e restrinja a chave a ela. Exige billing ativo.
#
# OPCIONAL. Sem ela, "Localizar pelo endereço" usa o OpenStreetMap (Nominatim),
# que é gratuito e não pede chave, mas costuma achar a RUA e não a porta — a tela
# marca como "aproximada" e sugere conferir no mapa. Com a chave, o Google entra
# primeiro e o OpenStreetMap fica de reserva para quando ele falhar.
# Vale configurar quando houver volume: o Nominatim limita a 1 consulta/segundo.
GOOGLE_MAPS_API_KEY=

# O WhatsApp COMERCIAL — por onde todo dono de barbearia entra em contato.
# Dono não se cadastra sozinho (ver docs/promover-dono.md), então todo CTA de
# "quero na minha barbearia" abre esta conversa em vez do cadastro.
#
# ⚠️ NÃO É a integração de mensagens (logo abaixo). Isto só monta link wa.me.
#
# Opcionais: sem elas o site usa os valores de reserva de src/lib/config.ts e
# nada quebra. Preencha para trocar o número sem mexer no código.
# Formato do número: DDI + DDD + número, só dígitos.
NEXT_PUBLIC_WHATSAPP_NUMERO=
NEXT_PUBLIC_WHATSAPP_MENSAGEM=

# ⚠️ BLOQUEIA O DEPLOY. O canal de suporte do dono de barbearia e do cliente.
# Enquanto estiverem com PREENCHER_ANTES_DO_DEPLOY (ou vazios), o bloco de
# suporte não é renderizado em produção — ver src/lib/suporte.ts.
# O telefone aceita qualquer formato; o código extrai os dígitos e monta o
# tel: e o wa.me. Use DDD + número, com ou sem o 55.
NEXT_PUBLIC_SUPORTE_EMAIL=PREENCHER_ANTES_DO_DEPLOY
NEXT_PUBLIC_SUPORTE_TELEFONE=PREENCHER_ANTES_DO_DEPLOY

# ---------------------------------------------------------------------------
# WhatsApp OFICIAL — Meta Cloud API (confirmação, lembrete, cancelamento)
# ---------------------------------------------------------------------------
# Passo a passo completo, do painel da Meta ao cron: docs/whatsapp.md.
#
# TODAS SÃO SEGREDO, só servidor. Nenhuma pode ganhar prefixo NEXT_PUBLIC_.
#
# Sem elas nada quebra — e é justamente esse o perigo: o site sobe, o cliente
# agenda, e NENHUMA mensagem sai, sem erro na tela. O interruptor é
# WHATSAPP_PHONE_NUMBER_ID: vazio, a integração inteira fica desligada. Com
# ele preenchido, as outras passam a ser obrigatórias e a falta de qualquer
# uma aparece no log do servidor.

# "Phone Number ID" — WhatsApp → Configuração da API, no app da Meta.
# NÃO é o telefone: é um número longo que identifica o telefone na Meta.
WHATSAPP_PHONE_NUMBER_ID=
# "WhatsApp Business account ID" — mesma tela, logo abaixo.
WHATSAPP_WABA_ID=
# Token de USUÁRIO DO SISTEMA (permanente). O do botão "Gerar token" expira
# em 24h e derruba a integração no dia seguinte. Ver docs/whatsapp.md §3.
WHATSAPP_ACCESS_TOKEN=
# App → Configurações → Básico → Chave secreta do aplicativo. Assina o webhook.
WHATSAPP_APP_SECRET=
# Você inventa: `openssl rand -base64 32`. Cole o MESMO valor no painel da Meta.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Opcional. Sem ela, v25.0.
WHATSAPP_GRAPH_VERSION=v25.0

# Protege /api/cron/whatsapp. Você inventa: `openssl rand -base64 32`.
# Sem ele o endpoint recusa todo mundo — e os lembretes nunca saem.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Asaas — cobrança das assinaturas (ver supabase/26_assinaturas.sql)
# ---------------------------------------------------------------------------
# Sem ASAAS_API_KEY a cobrança fica desligada: a tela de assinatura abre, mas
# não deixa pagar. A chave começa com `$` — ESCAPE com barra invertida, senão
# o Next a lê vazia:  ASAAS_API_KEY=\$aact_hmlg_...
# Sandbox (`$aact_hmlg_`) ou produção (`$aact_prod_`) sai do prefixo da chave.
ASAAS_API_KEY=
# Senha que você inventa e cadastra no webhook do Asaas (header asaas-access-token).
ASAAS_WEBHOOK_TOKEN=
